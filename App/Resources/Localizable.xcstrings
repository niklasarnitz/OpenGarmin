        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Stressmesswerte in diesem Zeitraum."
          }
        }
      }
    },
    "Working hours are %@ points higher than after hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Arbeitszeit liegt %@ Punkte über dem Wert nach Feierabend."
