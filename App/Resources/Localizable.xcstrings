    },
    "Working hours are %@ points lower than after hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Arbeitszeit liegt %@ Punkte unter dem Wert nach Feierabend."
          }
        }
      }
    },
    "Working hours and after hours are about the same." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitszeit und Zeit nach Feierabend liegen etwa gleichauf."
          }
        }
      }
    },
    "Stress while asleep is %@ points higher than after hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress im Schlaf liegt %@ Punkte über dem Wert nach Feierabend."
          }
        }
      }
    },
    "Stress while asleep is %@ points lower than after hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress im Schlaf liegt %@ Punkte unter dem Wert nach Feierabend."
          }
        }
      }
    },
    "Stress while asleep is about the same as after hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress im Schlaf liegt etwa auf dem Niveau nach Feierabend."
          }
        }
      }
    },
    "About this" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund"
          }
        }
      }
    },
    "Each stress reading is filed under one context. Sleep comes first: readings inside a night's sleep count as asleep. Weekends are awake time on Saturday and Sunday outside working hours. Readings of 0 were not measured and are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Stressmesswert gehört zu genau einem Kontext. Schlaf hat Vorrang: Messwerte innerhalb der Nachtschlafphase zählen als Schlaf. Wochenende sind wache Zeiten an Samstag und Sonntag außerhalb der Arbeitszeit. Messwerte von 0 wurden nicht gemessen und fehlen in der Auswertung."
          }
        }
      }
    },
    "Working days" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitstage"
          }
        }
      }
    },
    "End must be after the start. Until then, no reading counts as working time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ende muss nach dem Beginn liegen. Bis dahin zählt kein Messwert als Arbeitszeit."
          }
        }
      }
    },
    "Compared with your usual" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Vergleich zu deinem Üblichen"
