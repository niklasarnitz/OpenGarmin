    "bpm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bpm"
          }
        }
      }
    },
    "iOS does not tell apps whether the watch is bonded. OpenGarmin counts it as bonded while the watch is connected, because the connection asks iOS to pair." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS teilt Apps nicht mit, ob die Uhr gekoppelt ist. OpenGarmin zählt sie als gekoppelt, solange die Uhr verbunden ist, weil die Verbindung iOS zur Kopplung auffordert."
          }
        }
      }
    },
    "iOS shows a pairing request. Confirm the code on the watch and on the phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zeigt eine Kopplungsanfrage. Bestätige den Code auf der Uhr und dem iPhone."
